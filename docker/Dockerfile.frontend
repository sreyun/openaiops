# syntax=docker/dockerfile:1
# ============================================================
# AIOps Vue 控制台镜像（静态资源 + Nginx 反代 API/WS）
# ------------------------------------------------------------
# 构建：
#   docker build -f docker/Dockerfile.frontend -t aiops-frontend:dev .
# 开发 compose 会自动构建并挂到 http://127.0.0.1:8080/v2/
# ============================================================
ARG NODE_IMAGE=docker.io/library/node:22-alpine
ARG NGINX_IMAGE=docker.io/library/nginx:1.27-alpine
ARG NPM_REGISTRY=https://registry.npmmirror.com

# ---- Build Vue ----
FROM ${NODE_IMAGE} AS build
WORKDIR /src
ARG NPM_REGISTRY
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry="${NPM_REGISTRY}"
COPY frontend/ ./
# vite outDir 直接指向 ../cmd/server/web/v2（go:embed 目录），不再产到 /src/dist
RUN npm run build

# ---- Nginx runtime ----
FROM ${NGINX_IMAGE}
COPY docker/nginx/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /cmd/server/web/v2 /usr/share/nginx/html/v2
# 健康探活用固定文件，避免依赖后端
RUN printf 'ok\n' > /usr/share/nginx/html/v2/healthz.txt \
 && mkdir -p /var/cache/nginx \
 && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/v2/healthz.txt | grep -q ok || exit 1
CMD ["nginx", "-g", "daemon off;"]
