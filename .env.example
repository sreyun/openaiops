# ============================================================
# AIOps · Docker Compose 环境变量
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   # 编辑 .env 后：
#   docker compose up -d                                    # 正式
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build  # 开发
#
# 生产推荐：bash scripts/secure-compose.sh 自动生成强随机密钥写入 .env
# ============================================================

# ---------- 密钥（生产务必修改并备份） ----------
# PostgreSQL 密码（须与 AIOPS_POSTGRES_DSN 中密码一致；compose 已自动拼接 DSN）
POSTGRES_PASSWORD=

# 配置落库主密钥（AES-256-GCM）。丢失后库内已加密凭据无法解密！
AIOPS_SECRET_KEY=

# 可选：LLM Gateway/SDK 结构化审计摄入令牌（建议 ≥24 字符随机串）
AIOPS_CONTENT_AUDIT_INGEST_TOKEN=

# 可选：Agent 安装 Token（compose 的 aiops-agent 与 server 共用）
# 留空：server 首次启动自动生成，并写入 ./data/.install_token 供 sidecar 自动注册
# 生产推荐：secure-compose.sh 会写入随机值，或自行设置 ≥16 位随机串
AIOPS_INSTALL_TOKEN=

# compose 本机 Agent 分类标签 / 稳定机器标识（可选）
# AIOPS_AGENT_CATEGORY=Docker
# AIOPS_AGENT_MACHINE_ID=aiops-compose-agent

# ---------- 端口 / 时区 ----------
AIOPS_HTTP_PORT=8529
AIOPS_FORWARD_PORT_RANGE=10100-10300
TZ=Asia/Shanghai

# ---------- 存储地址（容器内默认即可） ----------
AIOPS_VM_URL=http://victoriametrics:8428

# ---------- 镜像（正式默认华为云 SWR；本机拉不到时可改 Docker Hub） ----------
# AIOPS_IMAGE_TAG=latest
# AIOPS_SERVER_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/aiops-server
# AIOPS_AGENT_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/aiops-agent
# POSTGRES_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/pgvector:pg18
# VM_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/victoria-metrics:latest

# 本地 --build 基础镜像前缀（golang/alpine 等）。默认国内 SWR 同步仓；
# 海外或 SWR 缺标签时改为：BASE_REGISTRY=docker.io
# BASE_REGISTRY=swr.cn-east-3.myhuaweicloud.com/sreyun/docker.io

# ---------- 开发 overlay（可选） ----------
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# AIOPS_DEV_VERSION=dev
# WEBSITE_PORT=8090
# WEBSITE_ADMIN_PASSWORD=请改成强密码
